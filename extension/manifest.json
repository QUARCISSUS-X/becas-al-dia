{
  "manifest_version": 3,
  "name": "Becas al Día",
  "short_name": "Becas al Día",
  "version": "4.2.1",
  "description": "Becas, eventos y cursos verificados por Claude cada semana, radar diario de convocatorias y búsqueda de empleo para ingeniería en Perú. Tu propia IA es opcional.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Becas al Día",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "downloads",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://pe.computrabajo.com/*",
    "https://www.bumeran.com.pe/*",
    "https://app.servir.gob.pe/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
