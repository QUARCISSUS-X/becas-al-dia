{
  "manifest_version": 3,
  "name": "Becas al Día",
  "short_name": "Becas al Día",
  "version": "0.1.0",
  "description": "Becas con fechas verificadas a diario y búsqueda de empleo y prácticas. Se actualiza sola, sin IA ni costo.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Becas al Día", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "host_permissions": ["https://raw.githubusercontent.com/*"]
}
